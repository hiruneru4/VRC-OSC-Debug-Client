<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>VRC OSC Debug Client</AssemblyName>
    <RootNamespace>VRCOscDebugClient</RootNamespace>
    <Product>VRC OSC Debug Client</Product>
    <AssemblyTitle>VRC OSC Debug Client</AssemblyTitle>
    <Description>VRChat OSC debug client</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 英語表示用の翻訳 (exe と同じフォルダの Lang に置く。編集すると表示が変わる) -->
    <None Update="Lang\en.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
